# Copie para .env e preencha so o que for usar. Nenhuma chave e necessaria na Fase 1.
# O .env nunca vai para o git (ver .gitignore).

# --- Fase 3: trilha e SFX (opcionais) ---
TREBLO_API_KEY=            # trilha gerada por IA (treblo_music.py)
PEXELS_API_KEY=            # imagens e video de banco (pexels_search.py)
EPIDEMIC_SOUND_MCP_API_KEY= # catalogo Epidemic via MCP (epidemic_music.py); chave "MCP Server" em epidemicsound.com/account/api-keys

# --- Pesquisa de imagens (opcionais) ---
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Diarizacao / modelos Hugging Face (extra "diarize") ---
HF_TOKEN=                  # pyannote exige aceitar a licenca do modelo e um token

# --- Publicacao (opcional) ---
POSTIZ_API_KEY=
POSTIZ_BASE_URL=
